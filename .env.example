# Frontend: where to fetch tone.json from in production.
# In local dev this is unset, and the app falls back to /tone.json (the
# synthetic sample from `npm run sample-data`).
VITE_TONE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev/tone.json

# Pipeline (only needed when running `npm run refresh-tone` locally).
# In CI these come from GitHub Actions secrets.
GCP_PROJECT_ID=your-gcp-project
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=emotional-world
